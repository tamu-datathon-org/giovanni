{
  "name": "@vanni/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.tsx",
      "./src/*.ts"
    ]
  },
  "scripts": {
    "add": "pnpm dlx shadcn-ui add",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "ui-add": "pnpm dlx shadcn-ui add && prettier src --write --list-different"
  },
  "prettier": "@vanni/prettier-config",
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-icons": "catalog:",
    "@radix-ui/react-label": "catalog:",
    "@radix-ui/react-slider": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "class-variance-authority": "catalog:",
    "next-themes": "^0.3.0",
    "react-hook-form": "catalog:",
    "sonner": "^1.7.4",
    "tailwind-merge": "catalog:",
    "tailwindcss-animate": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@vanni/eslint-config": "workspace:*",
    "@vanni/prettier-config": "workspace:*",
    "@vanni/tailwind-config": "workspace:*",
    "@vanni/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "next": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "18.3.1",
    "zod": "^4.3.6"
  }
}
