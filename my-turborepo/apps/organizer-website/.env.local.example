# Copy this file to `.env.local` for local development.
#
# organizer-website runs on port 3001. Better Auth builds its OAuth callback /
# redirect_uri from BETTER_AUTH_URL, and the shared root .env sets that to
# http://localhost:3000 (team-website). Without this per-app override, the
# organizer OAuth flow redirects to :3000 and fails with "state_mismatch".
#
# The `dev` script loads this file BEFORE ../../.env (dotenv-cli: first file
# wins), so this value overrides the shared root BETTER_AUTH_URL locally.
BETTER_AUTH_URL=http://localhost:3001
