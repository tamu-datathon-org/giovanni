# ---------------------------------------------------------------------------
# @vanni/organizer-website -- environment variables
#
# Copy to `.env.local` (local dev) or paste into Coolify's Environment
# Variables tab (production). NEVER commit real values.
#
# NOTE ON AUTH: this app uses **better-auth** with Auth0 as a generic OAuth
# provider. There is no AUTH0_BASE_URL / AUTH0_ISSUER_BASE_URL here -- the
# equivalent knob is BETTER_AUTH_URL.
# ---------------------------------------------------------------------------

# === BUILD-TIME (NEXT_PUBLIC_*) ============================================
# Inlined into the client bundle by `next build`. These MUST be supplied as
# Docker build args; setting them only at runtime has no effect.

# Selects the event row used for organizer role checks. Defaults to "Datathon".
NEXT_PUBLIC_EVENT_NAME="Datathon"

# Google OAuth client ID used by the Drive/Sheets picker widgets.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Google Drive folder the resume/asset uploader writes into.
NEXT_PUBLIC_DRIVE_FOLDER_ID=""
NEXT_PUBLIC_DRIVE_FOLDER_NAME=""

# Apps Script /exec endpoint backing /organizer/schedule-manager. Optional: if
# unset, that page renders a visible "Schedule API unavailable" error instead of
# an empty list. Must be a full URL when provided.
NEXT_PUBLIC_GOOGLE_SHEET_API_URL=""

# "development" turns on the tRPC logger link. Use "production" for deploys.
NEXT_PUBLIC_ENV="production"


# === RUNTIME -- AUTH (Auth0 via better-auth) ===============================

# Public origin of THIS deployment. better-auth builds every OAuth
# redirect_uri and callback from it, and trusts its own origin.
#   local dev  -> http://localhost:3000
#   production -> https://organizer.tamudatathon.org
# A wrong value here is the usual cause of "state_mismatch" on login.
BETTER_AUTH_URL="https://organizer.tamudatathon.org"

# Auth0 application credentials (Auth0 Dashboard -> Applications).
AUTH_AUTH0_ID=""
AUTH_AUTH0_SECRET=""
# Full origin including scheme, no trailing slash, e.g. https://tamudatathon.us.auth0.com
AUTH_AUTH0_DOMAIN=""

# Signs better-auth sessions. Required in production.
#   openssl rand -base64 32
AUTH_SECRET=""


# === RUNTIME -- DATABASE ===================================================

# Postgres (Supabase pooler). Used by @vanni/db and drizzle-kit.
POSTGRES_URL="postgres://postgres.[USER]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"


# === RUNTIME -- AWS (transactional email via SES + SQS) ====================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_EMAIL_USER="connect@tamudatathon.com"
AWS_SQS_MAIL_URL="https://sqs.us-east-1.amazonaws.com/000000000000/mail-queue"


# === RUNTIME -- BLOB STORAGE ===============================================
# Vercel Blob token used by the email-generator image uploader.
BLOB_READ_WRITE_TOKEN=""


# === BUILD ESCAPE HATCH ====================================================
# Set by the Dockerfile during `next build` so server secrets are not required
# at image-build time. Do NOT set this at runtime.
# SKIP_ENV_VALIDATION="true"
